;
; PabulongMic.inf: the "Pabulong Mic" virtual microphone.
; Copyright (c) 2026 Next Matter Pro. MIT License.
;
; A root-enumerated audio adapter with one capture endpoint. Installed by
; pabulong-setup.exe (creates the device node Root\PabulongMic, then
; installs this package on it). Declarative/universal: no co-installers,
; no writes outside HKR.

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 01/01/2026,0.1.0.0
CatalogFile = PabulongMic.cat
PnpLockDown = 1

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
PabulongMic.sys = 1

[DestinationDirs]
Pabulong.CopyFiles = 13

[Manufacturer]
%MfgName% = Pabulong, NT$ARCH$.10.0...19041

[Pabulong.NT$ARCH$.10.0...19041]
%Pabulong.DeviceDesc% = Pabulong_Device, Root\PabulongMic

[Pabulong.CopyFiles]
PabulongMic.sys

[Pabulong_Device.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = Pabulong.CopyFiles
AddReg    = Pabulong.AddReg

[Pabulong.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,PabulongMic.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Pabulong.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%Pabulong.DeviceDesc%

[Pabulong_Device.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Wave%,     Pabulong.I.Wave
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Wave%,     Pabulong.I.Wave
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_Wave%,     Pabulong.I.Wave
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Topology%, Pabulong.I.Topology
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_Topology%, Pabulong.I.Topology

[Pabulong.I.Wave]
AddReg = Pabulong.I.Wave.AddReg

[Pabulong.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Pabulong.DeviceDesc%

[Pabulong.I.Topology]
AddReg = Pabulong.I.Topology.AddReg

[Pabulong.I.Topology.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Pabulong.DeviceDesc%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[Pabulong_Device.NT.Services]
AddService = PabulongMic, 0x00000002, Pabulong.Service

[Pabulong.Service]
DisplayName   = %Pabulong.ServiceDesc%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\PabulongMic.sys

[Pabulong_Device.NT.HW]
AddReg = Pabulong.HW.AddReg

[Pabulong.HW.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[Strings]
ProviderName          = "Next Matter Pro"
MfgName               = "Next Matter Pro"
DiskName              = "Pabulong Mic Installation Disk"
Pabulong.DeviceDesc   = "Pabulong Mic"
Pabulong.ServiceDesc  = "Pabulong Mic virtual microphone"

KSNAME_Wave           = "WavePabulongMic"
KSNAME_Topology       = "TopologyPabulongMic"

Proxy.CLSID           = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO      = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE    = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME   = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY   = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY        = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
